      <PARAM name="POL" datatype="char" arraysize="*" value="">
        <DESCRIPTION>Specify polarization states</DESCRIPTION>
      </PARAM>
      <PARAM name="POS" datatype="char" arraysize="*" value="" xtype="polygon">
        <DESCRIPTION>Specify polygon of interest</DESCRIPTION>
      </PARAM>
      <PARAM name="POS" datatype="char" arraysize="*" value="" xtype="range">
        <DESCRIPTION>Specify range of interest</DESCRIPTION>
      </PARAM>
      <PARAM name="POS" datatype="char" arraysize="*" value="" xtype="circle">
        <DESCRIPTION>Specify circle of interest</DESCRIPTION>
      </PARAM>
      <PARAM name="RESPONSEFORMAT" datatype="char" arraysize="*" value="">
        <DESCRIPTION>specify format of response</DESCRIPTION>
        <VALUES type="actual">
          <OPTION value="csv"/>
          <OPTION value="db"/>
          <OPTION value="fits"/>
          <OPTION value="hdf5"/>
          <OPTION value="html"/>
          <OPTION value="ipac_table"/>
          <OPTION value="json"/>
          <OPTION value="json5"/>
          <OPTION value="oracle"/>
          <OPTION value="postgres"/>
          <OPTION value="sqlite"/>
          <OPTION value="text"/>
          <OPTION value="tsv"/>
          <OPTION value="votable"/>
          <OPTION value="xml"/>
        </VALUES>
      </PARAM>
      <PARAM name="SPATRES" datatype="double" arraysize="2" unit="arcsec" value="" xtype="interval">
        <DESCRIPTION>Specify position resolution</DESCRIPTION>
      </PARAM>
      <PARAM name="SPECRP" datatype="double" arraysize="2" value="" xtype="interval">
        <DESCRIPTION>Specify energy resolving power</DESCRIPTION>
      </PARAM>
      <PARAM name="TARGET" datatype="char" arraysize="*" value="">
        <DESCRIPTION>Specify target name</DESCRIPTION>
      </PARAM>
      <PARAM name="TIME" datatype="double" arraysize="2" unit="d" value="" xtype="interval">
