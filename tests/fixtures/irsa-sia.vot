          <OPTION value="The 2 Micron All Sky Survey 1.3m Telescope at Fred Lawrence Whipple Observatory"/>
          <OPTION value="Wide-field Infrared Survey Explorer"/>
          <OPTION value="WISE"/>
        </VALUES>
      </PARAM>
      <PARAM name="FORMAT" datatype="char" arraysize="*" value="">
        <DESCRIPTION>Specify content type</DESCRIPTION>
        <VALUES type="actual">
          <OPTION value="application/fits"/>
          <OPTION value="application/x-gzip"/>
          <OPTION value="cube/fits"/>
          <OPTION value="image/fits"/>
          <OPTION value="image/png"/>
          <OPTION value="plain/text"/>
          <OPTION value="text/plain"/>
        </VALUES>
      </PARAM>
      <PARAM name="FOV" datatype="double" arraysize="2" unit="deg" value="" xtype="interval">
        <DESCRIPTION>Specify field of view</DESCRIPTION>
      </PARAM>
      <PARAM name="ID" datatype="char" arraysize="*" value="">
        <DESCRIPTION>Specify observation ID</DESCRIPTION>
      </PARAM>
      <PARAM name="INSTRUMENT" datatype="char" arraysize="*" value="">
